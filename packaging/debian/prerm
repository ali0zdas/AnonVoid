#!/bin/sh
# ==============================================================================
# AnonVoid — Debian Kaldırma Öncesi Betiği (prerm)
# ==============================================================================

set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Servis çalışıyorsa durdur ve devreden çıkar
        if [ -d /run/systemd/system ]; then
            systemctl stop anonvoid.service >/dev/null 2>&1 || true
            systemctl disable anonvoid.service >/dev/null 2>&1 || true
            systemctl stop fp-cleaner.service >/dev/null 2>&1 || true
            systemctl disable fp-cleaner.service >/dev/null 2>&1 || true
        fi
        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm çağrıldı ancak argüman tanınmadı: $1" >&2
        exit 1
        ;;
esac

exit 0
