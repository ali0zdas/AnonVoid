[Unit]
Description=AnonVoid Root IPC Daemon
Documentation=file:///opt/anonvoid/docs/ARCHITECTURE.md
After=network.target network-online.target tor.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# Adli iz bırakmayı önlemek için bytecode üretimini kapat
Environment=PYTHONDONTWRITEBYTECODE=1

# Çalıştırıcı komut
ExecStart=/usr/local/bin/anonvoid --service

# Güvenli çalışma dizini ve grup izinleri
RuntimeDirectory=anonvoid
RuntimeDirectoryMode=0755
KillMode=mixed
TimeoutStopSec=10
Restart=on-failure
RestartSec=3s

# Güvenlik ve İzolasyon Sertleştirmesi (Hardening)
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
# Tor yapılandırması, DNS kilidi ve Tor çerezleri için gerekli YAZMA izinleri.
# ProtectSystem=full /etc'yi salt-okunur yapar; bu satırlar olmadan daemon
# /etc/tor/torrc ve /etc/resolv.conf yazamaz, "korumayı başlat" sessizce
# başarısız olur. Sadece bu iki yol açılır, geri kalanı salt-okunur kalır.
ReadWritePaths=/etc/tor /etc/resolv.conf
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_CHOWN

[Install]
WantedBy=multi-user.target
